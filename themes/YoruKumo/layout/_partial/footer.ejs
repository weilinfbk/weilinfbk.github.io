<footer class="footer-container">
  <div class="footer-content">
    <p class="footer-text">
      © <%= new Date().getFullYear() %>
      <a href="<%= theme.footer.authorLink %>" target="_blank"><%= theme.about.name %></a>.
      All Rights Reserved.
    </p>
    <p class="footer-text">
  Powered by <a href="https://hexo.io" target="_blank">Hexo</a> |Themes by <a href="https://github.com/asukacc/YoruKumo" target="_blank">YoruKumo</a> & <a href="https://github.com/LyraVoid/Mizuki" target="_blank">Tessera</a>|
  <span style="font-size: 0.9em; color: #888;">RSS 订阅:</span> 
  <!-- 下面这行是重点，把网址直接作为纯文本展示出来，加了 user-select: all 方便手机一键全选 -->
  <span style="color: #4a5df9; user-select: all; -webkit-user-select: all; cursor: pointer;" title="点击全选">https://weilinfbk.github.io/atom.xml</span>
    <p class="footer-text">
      <span><%= __('footer.runtime') %></span>
      <span id="runtime" class="runtime-badge"></span>
    </p>
  </div>
</footer>

<script>
  function calculateRuntime() {
    // 网站开始运行的时间，格式：年-月-日
    const startTime = new Date('<%= theme.footer.since %>');
    const currentTime = new Date();

    const timeDiff = currentTime - startTime;
    const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
    );
    const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeDiff % (1000 * 60)) / 1000);

    const dayStr = '<%= __("footer.day") %>';
    const hourStr = '<%= __("footer.hour") %>';
    const minuteStr = '<%= __("footer.minute") %>';
    const secondStr = '<%= __("footer.second") %>';

    document.getElementById(
      'runtime'
    ).innerHTML = `${days}${dayStr}${hours}${hourStr}${minutes}${minuteStr}${seconds}${secondStr}`;
  }

  // 初始运行
  calculateRuntime();
  // 每秒更新一次
  setInterval(calculateRuntime, 1000);
</script>

