<div class="post-page-wrapper">
  <main class="post-container">
    <article class="post-card">
      
      <!-- 1. 顶部封面图 -->
      <% if (page.cover || page.top_img) { %>
        <div class="post-cover">
          <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
        </div>
      <% } %>

      <!-- 2. 标题和元信息 -->
      <div class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        
        <div class="post-meta">
          <!-- 显示具体时间 -->
          <span>📅 发表于 <%= date(page.date, 'YYYY-MM-DD HH:mm') %></span>
          
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-divider">|</span>
            <span>📁 <%= page.categories.data[0].name %></span>
          <% } %>
          
          <span class="meta-divider">|</span>
          <span>📝 字数: <%= wordcount(page.content) %></span>
          
          <span class="meta-divider">|</span>
          <span>⏱️ 阅读: <%= min2read(page.content) %> 分钟</span>
        </div>
      </div>

      <!-- 3. 正文内容 -->
      <div class="post-content">
        <%- page.content %>
      </div>

    </article>
  </main>
</div>

<!-- 样式部分 -->
<style>
  /* 页面背景变深色 */
  body {
    background-color: #121212 !important; 
  }

  /* ⚠️ 注意：这里把之前强制隐藏 header 的代码删掉了，所以 Weilin Blog 会回来！ */

  /* 外层容器，加上一点顶部负边距，让卡片稍微往上提一点，不跟导航栏离得太远 */
  .post-page-wrapper {
    padding: 20px 20px 40px;
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .post-container {
    width: 100%;
    max-width: 850px;
    margin-top: -40px; /* 让卡片往上浮动一点 */
    position: relative;
    z-index: 10;
  }

  /* 暗黑卡片主体 */
  .post-card {
    background-color: #1e1e1e;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.05);
  }

  /* 卡片内的封面图 */
  .post-cover img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  /* 头部区域 */
  .post-header {
    padding: 35px 40px 10px;
  }

  /* 大标题 */
  .post-title {
    font-size: 2.2rem;
    color: #ffffff;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 20px 0;
  }

  /* 元信息排版 */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: #888888;
    font-size: 0.95rem;
    margin-bottom: 15px;
  }
  
  .meta-divider {
    color: #444;
    margin: 0 4px;
  }

  /* 正文区域 */
  .post-content {
    padding: 15px 40px 40px;
    color: #d4d4d4;
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.5px;
  }

  .post-content a { color: #66b2ff; text-decoration: none; }
  .post-content strong { color: #ffffff; }
  .post-content img { max-width: 100%; border-radius: 8px; margin: 15px 0; }

  /* 📱 手机端适配 */
  @media (max-width: 768px) {
    .post-page-wrapper {
      padding: 10px;
    }
    .post-container {
      margin-top: -20px; /* 手机上上浮少一点 */
    }
    .post-header {
      padding: 20px 20px 10px;
    }
    .post-content {
      padding: 10px 20px 30px;
    }
    .post-title {
      font-size: 1.7rem;
    }
    .post-meta {
      font-size: 0.85rem;
    }
    .meta-divider {
      display: none; /* 手机屏幕窄，隐藏竖线 */
    }
  }
</style>
