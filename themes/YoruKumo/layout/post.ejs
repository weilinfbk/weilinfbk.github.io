<%- partial('_partial/header') %>

<div class="post-page">
  <!-- 顶部大图 Banner -->
  <% if (page.cover || page.top_img) { %>
    <div class="post-banner">
      <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
    </div>
  <% } %>

  <main class="post-container">
    <article class="post-article">
      
      <!-- 标题和详细信息区域 -->
      <header class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        
        <div class="post-meta">
          <span class="meta-item">📅 发表于 <%= date(page.date, 'YYYY-MM-DD') %></span>
          
          <% if (page.updated && page.updated != page.date) { %>
            <span class="meta-item">🕒 更新于 <%= date(page.updated, 'YYYY-MM-DD') %></span>
          <% } %>
          
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-item">📁 <%= page.categories.data[0].name %></span>
          <% } %>
          
          <!-- 字数和阅读时长（依赖 hexo-wordcount） -->
          <span class="meta-item">📝 字数: <%= wordcount(page.content) %></span>
          <span class="meta-item">⏱️ 阅读: <%= min2read(page.content) %>分钟</span>
        </div>
      </header>

      <!-- 正文区域 -->
      <div class="post-content"><%- page.content %></div>

      <!-- 底部翻页 -->
      <footer class="post-footer">
        <div class="post-nav">
          <% if (page.prev) { %>
            <div class="post-nav-prev">
              <i class="fa fa-chevron-left"></i>
              <a href="<%- url_for(page.prev.path) %>" rel="prev"><%= page.prev.title %></a>
            </div>
          <% } else { %>
            <div class="post-nav-prev"></div>
          <% } %>
          
          <% if (page.next) { %>
            <div class="post-nav-next">
              <a href="<%- url_for(page.next.path) %>" rel="next"><%= page.next.title %></a>
              <i class="fa fa-chevron-right"></i>
            </div>
          <% } %>
        </div>
      </footer>
      
    </article>
  </main>

  <%- partial('_partial/pagination', { page: page }) %>
</div>

<!-- 页面专属样式 -->
<style>
  /* 顶部大图 */
  .post-banner {
    width: 100%;
    height: 40vh; /* 高度占屏幕的40%，可以自己调 */
    min-height: 300px;
    overflow: hidden;
    position: relative;
  }
  .post-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 保证图片铺满且不变形 */
  }

  /* 正文容器，限制最大宽度，阅读更舒服 */
  .post-container {
    max-width: 800px;
    margin: -60px auto 50px; /* 负边距让它稍微往上浮动，压住一点点大图 */
    padding: 0 20px;
    position: relative;
    z-index: 10;
  }

  /* 文章卡片（白色或暗色背景） */
  .post-article {
    background: var(--bg-color, #1e1e1e); /* 自动适配主题背景色 */
    padding: 40px;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  }

  /* 标题 */
  .post-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  /* 信息栏（横向排列） */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(128,128,128,0.2);
  }

  /* 正文排版优化 */
  .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-color, #d1d1d1);
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .post-container {
      margin: -30px auto 20px;
      padding: 0 15px;
    }
    .post-article {
      padding: 20px;
    }
    .post-title {
      font-size: 1.6rem;
    }
  }
/* 强制显示，防止被主题动画隐藏 */
.post-page, .post-article, .post-content {
  opacity: 1 !important; 
  visibility: visible !important;
  transform: none !important;
}
</style>
