<!-- 1. 引入顶部导航栏（把 Weilin Blog 和三条线找回来） -->
<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    <article class="post-card">
      
      <!-- 2. 顶部封面图 -->
      <% if (page.cover || page.top_img) { %>
        <div class="post-cover">
          <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
        </div>
      <% } %>

      <!-- 3. 标题和元信息 -->
      <div class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        
        <div class="post-meta">
          <span>📅 发表于 <%= date(page.date, 'YYYY-MM-DD HH:mm') %></span>
          
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-divider">|</span>
            <span>📁 <%= page.categories.data[0].name %></span>
          <% } %>
          
          <span class="meta-divider">|</span>
          <span>📝 字数: <%= wordcount(page.content) %></span>
          
          <span class="meta-divider">|</span>
          <span>⏱️ 阅读: <%= min2read(page.content) %> 分钟</span>
        </div>
      </div>

      <!-- 4. 正文内容 -->
      <div class="post-content">
        <%- page.content %>
      </div>

    </article>
  </main>
</div>

<!-- 样式部分 -->
<style>
  /* 去掉了强制黑色背景，让主题原有的背景图和毛玻璃效果生效 */

  .post-page-wrapper {
    padding: 30px 20px 40px; /* 顶部留出 30px，防止被导航栏挡住 */
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .post-container {
    width: 100%;
    max-width: 850px;
    position: relative;
    z-index: 10;
  }

  /* 暗黑卡片主体 */
  .post-card {
    background-color: rgba(30, 30, 30, 0.95); /* 稍微带点透明质感 */
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    border: 1px solid rgba(255,255,255,0.05);
    backdrop-filter: blur(10px); /* 毛玻璃效果 */
  }

  /* 卡片内的封面图 */
  .post-cover img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  /* 头部区域 */
  .post-header {
    padding: 35px 40px 10px;
  }

  /* 大标题 */
  .post-title {
    font-size: 2.2rem;
    color: #ffffff;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 20px 0;
  }

  /* 元信息排版 */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: #aaaaaa;
    font-size: 0.95rem;
    margin-bottom: 15px;
  }
  
  .meta-divider {
    color: #555;
    margin: 0 4px;
  }

  /* 正文区域 */
  .post-content {
    padding: 15px 40px 40px;
    color: #d4d4d4;
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.5px;
  }

  .post-content a { color: #66b2ff; text-decoration: none; }
  .post-content strong { color: #ffffff; }
  .post-content img { max-width: 100%; border-radius: 8px; margin: 15px 0; }

  /* 📱 手机端适配 */
  @media (max-width: 768px) {
    .post-page-wrapper {
      padding: 90px 10px 20px; /* 手机端顶部留 90px */
    }
    .post-header {
      padding: 20px 20px 10px;
    }
    .post-content {
      padding: 10px 20px 30px;
    }
    .post-title {
      font-size: 1.7rem;
    }
    .post-meta {
      font-size: 0.85rem;
    }
    .meta-divider {
      display: none; 
    }
  }
</style>
