<div class="post-page-wrapper">
  <main class="post-container">
    
    <!-- 卡片1：封面 + 标题 + 元信息 -->
    <article class="post-card top-card">
      <% if (page.cover || page.top_img) { %>
        <div class="post-cover">
          <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
        </div>
      <% } %>

      <div class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        <div class="post-meta">
          <span>📅 发表于 <%= date(page.date, 'YYYY-MM-DD HH:mm') %></span>
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-divider">|</span>
            <span>📁 <%= page.categories.data[0].name %></span>
          <% } %>
          <span class="meta-divider">|</span>
          <span>📝 字数: <%= wordcount(page.content) %></span>
          <span class="meta-divider">|</span>
          <span>⏱️ 阅读: <%= min2read(page.content) %> 分钟</span>
        </div>
      </div>
    </article>

    <!-- 卡片2：正文内容 -->
    <article class="post-card content-card">
      <div class="post-content" id="article-content">
        <%- page.content %>
      </div>
    </article>

    <!-- ================= 新增：底部大图导航 ================= -->
    <div class="post-navigation">
      <!-- 上一篇 -->
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>" class="nav-card" style="background-image: url('<%- page.prev.cover || page.prev.top_img || '/images/avatar.jpg' %>');">
          <div class="nav-overlay">
            <span class="nav-label">上一篇</span>
            <span class="nav-title"><%= page.prev.title %></span>
          </div>
        </a>
      <% } %>

      <!-- 下一篇 (如果是最新文章，这里自动不显示) -->
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" class="nav-card" style="background-image: url('<%- page.next.cover || page.next.top_img || '/images/avatar.jpg' %>');">
          <div class="nav-overlay">
            <span class="nav-label">下一篇</span>
            <span class="nav-title"><%= page.next.title %></span>
          </div>
        </a>
      <% } %>
    </div>
    <!-- =================================================== -->

  </main>
</div>

<style>
  /* ================= 原有页面样式 ================= */
  body {
    padding-top: 20px !important; 
    background-color: #f5f5f5 !important; 
  }
  @media (prefers-color-scheme: dark) {
    body { background-color: #121212 !important; }
  }

  .post-page-wrapper {
    padding: 10px 20px 60px; 
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .post-container {
    width: 100%;
    max-width: 850px;
    display: flex;
    flex-direction: column;
    gap: 20px; 
  }

  .post-card {
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
  }
  .post-title { color: #222222; }
  .post-meta { color: #666666; }
  .post-content { color: #333333; }
  .meta-divider { color: #cccccc; margin: 0 4px; }

  @media (prefers-color-scheme: dark) {
    .post-card { background-color: #1e1e1e; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.05); }
    .post-title { color: #ffffff; }
    .post-meta { color: #aaaaaa; }
    .post-content { color: #d4d4d4; }
    .meta-divider { color: #555555; }
  }

  .post-cover img { width: 100%; max-height: 450px; object-fit: cover; display: block; }
  .post-header { padding: 30px 40px 10px; }
  .post-title { font-size: 2.2rem; font-weight: 700; line-height: 1.4; margin: 0 0 20px 0; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.95rem; margin-bottom: 10px; }
  .content-card { padding: 40px; }
  .post-content { font-size: 1.05rem; line-height: 1.9; letter-spacing: 0.5px; }
  .post-content img { max-width: 100%; border-radius: 12px; margin: 1.5rem 0; }
  .post-content pre { background: #1a1a1a !important; padding: 16px; border-radius: 12px; overflow-x: auto; }

  /* ================= 新增：导航卡片样式 ================= */
  .post-navigation {
    display: flex;
    flex-direction: column;
    gap: 15px; /* 上一篇和下一篇的间距 */
    margin-top: 10px;
  }

  .nav-card {
    position: relative;
    display: block;
    height: 160px;
    border-radius: 16px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  /* 黑色渐变遮罩，保证文字清晰可见 */
  .nav-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    transition: background 0.3s ease;
  }

  .nav-card:hover .nav-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.3) 100%);
  }

  .nav-label {
    color: #cccccc;
    font-size: 0.9rem;
    margin-bottom: 5px;
  }

  .nav-title {
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.4;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    body { padding-top: 15px !important; }
    .post-page-wrapper { padding: 10px 10px 30px; }
    .post-container { gap: 15px; }
    .post-header { padding: 20px 20px 10px; }
    .content-card { padding: 20px; }
    .post-title { font-size: 1.7rem; }
    .meta-divider { display: none; }
    
    /* 导航卡片手机端高度调整 */
    .nav-card { height: 130px; }
    .nav-title { font-size: 1.1rem; }
  }
</style>
