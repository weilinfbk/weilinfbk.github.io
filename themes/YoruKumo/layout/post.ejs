<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    <article class="post-card">
      
      <!-- 1. 顶部封面图 -->
      <% if (page.cover || page.top_img) { %>
        <div class="post-cover">
          <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
        </div>
      <% } %>

      <!-- 2. 标题和元信息 -->
      <div class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        
        <div class="post-meta">
          <span>📅 发表于 <%= date(page.date, 'YYYY-MM-DD HH:mm') %></span>
          
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-divider">|</span>
            <span>📁 <%= page.categories.data[0].name %></span>
          <% } %>
          
          <span class="meta-divider">|</span>
          <span>📝 字数: <%= wordcount(page.content) %></span>
          
          <span class="meta-divider">|</span>
          <span>⏱️ 阅读: <%= min2read(page.content) %> 分钟</span>
        </div>
      </div>

      <!-- 3. 正文内容 -->
      <div class="post-content">
        <%- page.content %>
      </div>

    </article>
  </main>
</div>

<style>
  .post-page-wrapper {
    padding: 120px 20px 40px !important;
    display: flex;
    justify-content: center;
    min-height: 100vh;
  }

  .post-container {
    width: 100%;
    max-width: 850px;
    margin-top: 0px !important; 
    position: relative;
    z-index: 10;
  }

  /* 默认亮色模式下的卡片 */
  .post-card {
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
  }
  .post-title { color: #222222; }
  .post-meta { color: #666666; }
  .post-content { color: #333333; }
  .meta-divider { color: #cccccc; margin: 0 4px; }

  /* 暗色模式自适应 */
  @media (prefers-color-scheme: dark) {
    .post-card {
      background-color: rgba(30, 30, 30, 0.95);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
    }
    .post-title { color: #ffffff; }
    .post-meta { color: #aaaaaa; }
    .post-content { color: #d4d4d4; }
    .meta-divider { color: #555555; }
  }

  /* 通用样式 */
  .post-cover img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  .post-header { padding: 35px 40px 10px; }

  .post-title {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 20px 0;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    margin-bottom: 15px;
  }

  .post-content {
    padding: 15px 40px 40px;
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.5px;
  }

  .post-content a { color: #66b2ff; text-decoration: none; }
  .post-content strong { color: inherit; }
  .post-content img { max-width: 100%; border-radius: 8px; margin: 15px 0; }

  @media (max-width: 768px) {
    .post-page-wrapper { padding: 10px 10px 20px; }
    .post-container { margin-top: -40px; }
    .post-header { padding: 20px 20px 10px; }
    .post-content { padding: 10px 20px 30px; }
    .post-title { font-size: 1.7rem; }
    .post-meta { font-size: 0.85rem; }
    .meta-divider { display: none; }
  }
</style>
