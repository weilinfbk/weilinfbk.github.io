<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    
    <!-- 第一个卡片：封面图 + 标题 + 信息 -->
    <article class="post-card top-card">
      <% if (page.cover || page.top_img) { %>
        <div class="post-cover">
          <img src="<%- page.cover || page.top_img %>" alt="<%= page.title %>">
        </div>
      <% } %>

      <div class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        
        <div class="post-meta">
          <span>📅 发表于 <%= date(page.date, 'YYYY-MM-DD HH:mm') %></span>
          <% if (page.categories && page.categories.length) { %>
            <span class="meta-divider">|</span>
            <span>📁 <%= page.categories.data[0].name %></span>
          <% } %>
          <span class="meta-divider">|</span>
          <span>📝 字数: <%= wordcount(page.content) %></span>
          <span class="meta-divider">|</span>
          <span>⏱️ 阅读: <%= min2read(page.content) %> 分钟</span>
        </div>
      </div>
    </article>

    <!-- 第二个卡片：正文内容 -->
    <article class="post-card content-card">
      <div class="post-content">
        <%- page.content %>
      </div>
    </article>

  </main>
</div>

<style>
  /* 隐藏多余的头部 */
  .swiper, .banner, .post-page > header, body > header { display: none !important; }
  body { padding-top: 80px !important; background-color: #f5f5f5 !important; }
  @media (prefers-color-scheme: dark) { body { background-color: #121212 !important; } }

  .post-page-wrapper {
    padding: 20px 20px 60px;
    display: flex;
    justify-content: center;
  }

  /* 关键点：用 flex 布局，让两个卡片中间产生缝隙 */
  .post-container {
    width: 100%;
    max-width: 850px;
    display: flex;
    flex-direction: column;
    gap: 20px; /* 👈 这就是上下两个卡片的间距 */
  }

  /* 卡片基础样式 */
  .post-card {
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
  }

  /* 暗色模式卡片 */
  @media (prefers-color-scheme: dark) {
    .post-card {
      background-color: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  /* 顶部卡片：让图片和标题自然贴合 */
  .top-card {
    padding-bottom: 10px;
  }
  .post-cover img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }
  .post-header { padding: 35px 40px 10px; }
  .post-title { font-size: 2.2rem; font-weight: 700; line-height: 1.4; margin: 0 0 20px 0; color: #222; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.95rem; color: #666; }
  .meta-divider { color: #ccc; margin: 0 4px; }

  /* 底部卡片：正文区域 */
  .content-card {
    padding: 40px; /* 整个卡片四周留白 */
  }
  .post-content {
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.5px;
    color: #333;
  }

  /* 正文里的元素美化 */
  .post-content h2 { font-size: 1.6rem; margin: 2rem 0 1rem; border-bottom: 1px solid rgba(128,128,128,0.2); padding-bottom: 8px; }
  .post-content img { max-width: 100%; border-radius: 12px; margin: 1.5rem 0; }
  .post-content pre { background: #1a1a1a !important; padding: 16px; border-radius: 12px; overflow-x: auto; }
  .post-content code { font-family: monospace; }
  
  /* 暗色模式下的文字 */
  @media (prefers-color-scheme: dark) {
    .post-title { color: #ffffff; }
    .post-meta { color: #aaaaaa; }
    .meta-divider { color: #555555; }
    .post-content { color: #d4d4d4; }
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    body { padding-top: 60px !important; }
    .post-page-wrapper { padding: 10px 10px 30px; }
    .post-container { gap: 15px; }
    .post-header { padding: 20px 20px 10px; }
    .post-title { font-size: 1.7rem; }
    .post-meta { font-size: 0.85rem; }
    .meta-divider { display: none; }
    .content-card { padding: 20px; }
  }
</style>
