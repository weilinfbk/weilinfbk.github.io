<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    
    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <!-- 封面图部分 -->
        <div class="card-cover">
          <a href="<%- url_for(post.path) %>">
            <img src="<%- post.cover || post.top_img || '/images/avatar.jpg' %>" alt="<%= post.title %>">
          </a>
        </div>
        
        <!-- 文字信息部分 -->
        <div class="card-info">
          <h2 class="card-title">
            <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
          </h2>
          
          <p class="card-excerpt">
            <%- strip_html(post.excerpt || post.content).substring(0, 60) %>...
          </p>
          
          <!-- 日期和分类 -->
          <div class="card-meta">
            <span>📅 <%= date(post.date, 'YYYY-MM-DD HH:mm') %></span>
            <% if (post.categories && post.categories.length) { %>
              <span>📁 <%= post.categories.data[0].name %></span>
            <% } %>
          </div>

          <!-- Tags -->
          <% if (post.tags && post.tags.length) { %>
            <div class="card-tags">
              🏷️ 
              <% post.tags.each(function(tag, index) { %>
                <span><%= tag.name %></span><% if (index < post.tags.length - 1) { %>, <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>

  </main>
</div>

<style>
  /* 完全照搬文章页的外壳 */
  .post-page-wrapper {
    padding: 40px 20px 60px; 
    display: flex;
    justify-content: center;
  }

  .post-container {
    width: 100%;
    max-width: 850px; /* 和文章页一样宽 */
    display: flex;
    flex-direction: column;
    gap: 20px; 
  }

  .post-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  @media (prefers-color-scheme: dark) {
    .post-card {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* 图片高度完全照搬文章页 */
  .card-cover img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    display: block;
  }

  /* 内边距完全照搬文章页 (.post-header) */
  .card-info {
    padding: 30px 40px 10px;
    display: flex;
    flex-direction: column;
  }

  /* 标题完全照搬文章页 (.post-title) */
  .card-title {
    font-size: 2.2rem;
    margin: 0 0 20px 0;
    line-height: 1.4;
    font-weight: 700;
  }

  .card-title a { text-decoration: none; color: #222222; }
  .card-excerpt { color: #666666; }
  
  @media (prefers-color-scheme: dark) {
    .card-title a { color: #ffffff; }
    .card-excerpt { color: #aaaaaa; }
  }

  /* 摘要字号完全照搬文章正文 */
  .card-excerpt {
    font-size: 0.90rem;
    line-height: 1.9;
    margin-bottom: 15px;
  }

  /* 去掉了那条多余的 border-top 横线，字体大小和文章页的 meta 一致 */
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: #888888;
    padding-top: 10px;
  }

  .card-tags {
    margin-top: 10px;
    font-size: 0.95rem;
    color: #888888;
  }

  /* 手机端适配也完全照搬文章页 */
  @media (max-width: 768px) {
    .post-page-wrapper { padding: 30px 10px 30px; }
    .post-container { gap: 15px; }
    .card-info { padding: 20px 20px 10px; }
    .card-title { font-size: 1.7rem; }
    .card-cover img { max-height: 300px; }
  }
</style>
