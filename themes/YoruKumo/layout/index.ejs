<%- partial('_partial/header') %>

<!-- 页面内容（网格卡片版） -->
<div class="page-content">
  <div class="card-grid">
    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <!-- 封面图部分 -->
        <div class="card-cover">
          <a href="<%- url_for(post.path) %>">
            <img src="<%- post.cover || post.top_img || '/images/avatar.jpg' %>" alt="<%= post.title %>">
          </a>
        </div>
        
        <!-- 文字信息部分 -->
        <div class="card-info">
          <h2 class="card-title">
            <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
          </h2>
          
          <p class="card-excerpt">
            <%- strip_html(post.excerpt || post.content).substring(0, 60) %>...
          </p>
          
          <!-- 日期和分类 -->
          <div class="card-meta">
            <!-- 这里加了 HH:mm 显示时间 -->
            <span class="card-date">📅 <%= date(post.date, 'YYYY-MM-DD HH:mm') %></span>
            <% if (post.categories && post.categories.length) { %>
              <span class="card-category">📁 <%= post.categories.data[0].name %></span>
            <% } %>
          </div>

          <!-- 新增：日期下方的 Tags -->
          <% if (post.tags && post.tags.length) { %>
            <div class="card-tags">
              🏷️ 
              <% post.tags.each(function(tag, index) { %>
                <span><%= tag.name %></span><% if (index < post.tags.length - 1) { %>, <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</div>

<style>
  /* 网格容器 */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    max-width: 850px;
    margin: 30px auto;
    padding: 0 15px;
  }

  /* 单个卡片 */
  .post-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  @media (prefers-color-scheme: dark) {
    .post-card {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* 封面图 */
  .card-cover img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  /* 文字区域 */
  .card-info {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.3rem;
    margin: 0 0 12px 0;
    line-height: 1.5;
    font-weight: 700;
  }

  /* 标题和摘要亮色/暗色自适应 */
  .card-title a { text-decoration: none; color: #222222; }
  .card-excerpt { color: #666666; }
  @media (prefers-color-scheme: dark) {
    .card-title a { color: #ffffff; }
    .card-excerpt { color: #aaaaaa; }
  }

  .card-excerpt {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  /* 底部日期和分类 */
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #888888;
    border-top: 1px solid rgba(128,128,128,0.2);
    padding-top: 15px;
  }

  /* 新增：Tags 的样式 */
  .card-tags {
    margin-top: 10px;
    font-size: 0.8rem;
    color: #888888;
  }
</style>
