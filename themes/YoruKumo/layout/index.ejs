<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    
    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <div class="card-cover">
          <a href="<%- url_for(post.path) %>">
            <img src="<%- post.cover || post.top_img || '/images/avatar.jpg' %>" alt="<%= post.title %>">
          </a>
        </div>
        
        <div class="card-info">
          <h2 class="card-title">
            <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
          </h2>
          
          <p class="card-excerpt">
            <%- strip_html(post.excerpt || post.content).substring(0, 60) %>...
          </p>
          
          <div class="card-meta">
            <span class="card-date">📅 <%= date(post.date, 'YYYY-MM-DD HH:mm') %></span>
            <% if (post.categories && post.categories.length) { %>
              <span class="card-category">📁 <%= post.categories.data[0].name %></span>
            <% } %>
          </div>

          <% if (post.tags && post.tags.length) { %>
            <div class="card-tags">
              🏷️ 
              <% post.tags.each(function(tag, index) { %>
                <span><%= tag.name %></span><% if (index < post.tags.length - 1) { %>, <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>

  </main>
</div>

<style>
  .post-page-wrapper {
    padding: 40px 20px 60px; 
    display: flex;
    justify-content: center;
  }

  /* ⚠️ 核心修改点：最大宽度降到了 680px，告别笨重感 */
  .post-container {
    width: 100%;
    max-width: 680px; 
    display: flex;
    flex-direction: column;
    gap: 20px; 
  }

  .post-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  @media (prefers-color-scheme: dark) {
    .post-card {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* 图片高度保持 180px，看起来修长 */
  .card-cover img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.25rem;
    margin: 0 0 10px 0;
    line-height: 1.5;
    font-weight: 700;
  }

  .card-title a { text-decoration: none; color: #222222; }
  .card-excerpt { color: #666666; }
  
  @media (prefers-color-scheme: dark) {
    .card-title a { color: #ffffff; }
    .card-excerpt { color: #aaaaaa; }
  }

  .card-excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 15px;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #888888;
    border-top: 1px solid rgba(128,128,128,0.2);
    padding-top: 12px;
  }

  .card-tags {
    margin-top: 8px;
    font-size: 0.8rem;
    color: #888888;
  }

  @media (max-width: 768px) {
    .post-page-wrapper { padding: 30px 10px 30px; }
    .post-container { gap: 15px; }
    .card-info { padding: 16px; }
    .card-title { font-size: 1.1rem; }
    .card-cover img { height: 160px; }
  }
</style>
