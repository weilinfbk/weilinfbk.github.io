<%- partial('_partial/header') %>

<div class="post-page-wrapper">
  <main class="post-container">
    
    <!-- ========================================== -->
    <!-- 👇👇👇 在这里修改你的通告内容 👇👇👇 -->
    <!-- ========================================== -->
    <div class="notice-board">
      <div class="notice-icon">📢</div>
      <div class="notice-content">
        欢迎来到我的博客！最新通告：网站排版大更新，如果有任何问题欢迎在评论区留言告诉我哦！
      </div>
    </div>
    <!-- ========================================== -->
    <!-- 👆👆👆 通告修改结束 👆👆👆 -->
    <!-- ========================================== -->

    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <!-- 1. 封面图 -->
        <div class="card-cover">
          <a href="<%- url_for(post.path) %>">
            <img src="<%- post.cover || post.top_img || '/images/avatar.jpg' %>" alt="<%= post.title %>">
          </a>
        </div>
        
        <!-- 2. 文字信息 -->
        <div class="card-info">
          <h2 class="card-title">
            <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
          </h2>
          
          <p class="card-excerpt">
            <%- strip_html(post.excerpt || post.content).substring(0, 60) %>...
          </p>
          
          <div class="card-meta">
            <span>📅 <%= date(post.date, 'YYYY-MM-DD HH:mm') %></span>
            <% if (post.categories && post.categories.length) { %>
              <span class="meta-divider">|</span>
              <span>📁 <%= post.categories.data[0].name %></span>
            <% } %>
          </div>

          <% if (post.tags && post.tags.length) { %>
            <div class="card-tags">
              🏷️ 
              <% post.tags.each(function(tag, index) { %>
                <span><%= tag.name %></span><% if (index < post.tags.length - 1) { %>, <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>

  </main>
</div>

<style>
  /* ===== 排版基础样式（完全没动） ===== */
  .post-page-wrapper, .post-container, .post-card, .card-cover, .card-info, .notice-board {
    box-sizing: border-box;
  }

  .post-page-wrapper {
    padding: 30px 15px 60px; 
    display: flex;
    justify-content: center;
    width: 100%;
    overflow-x: hidden;
  }

  .post-container {
    width: 100%;
    max-width: 850px; 
    display: flex;
    flex-direction: column;
    gap: 20px; 
  }

  /* ===== 👇 新增：通告框的样式 👇 ===== */
  .notice-board {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 16px;
    padding: 16px 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    border-left: 5px solid #3b7bbf; /* 左侧醒目的蓝色边框 */
  }
  .notice-icon {
    font-size: 1.6rem;
    margin-right: 15px;
    animation: ring 2s infinite; /* 小铃铛动画 */
  }
  .notice-content {
    font-size: 0.95rem;
    color: #444444;
    line-height: 1.6;
    flex: 1;
  }
  
  @keyframes ring {
    0% { transform: rotate(0); }
    10% { transform: rotate(15deg); }
    20% { transform: rotate(-10deg); }
    30% { transform: rotate(5deg); }
    40% { transform: rotate(-5deg); }
    50% { transform: rotate(0); }
    100% { transform: rotate(0); }
  }

  /* 通告框暗色模式 */
  @media (prefers-color-scheme: dark) {
    .notice-board {
      background: #1e1e1e;
      border: 1px solid rgba(255,255,255,0.05);
      border-left: 5px solid #66b2ff; /* 暗色下用亮蓝色 */
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .notice-content {
      color: #d4d4d4;
    }
  }
  /* ===== 👆 通告框样式结束 👆 ===== */

  .post-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden; 
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    width: 100%; 
  }

  @media (prefers-color-scheme: dark) {
    .post-card {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  .card-cover {
    width: 100%;
    overflow: hidden; 
  }

  .card-cover img {
    width: 100%;
    aspect-ratio: 16 / 9; 
    object-fit: cover;    
    display: block;
  }

  .card-info {
    padding: 30px 40px 10px; 
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card-title {
    font-size: 2.2rem;
    margin: 0 0 20px 0;
    line-height: 1.4;
    font-weight: 700;
  }

  .card-title a { text-decoration: none; color: #222222; }
  .card-excerpt { color: #666666; }
  
  @media (prefers-color-scheme: dark) {
    .card-title a { color: #ffffff; }
    .card-excerpt { color: #aaaaaa; }
  }

  .card-excerpt {
    font-size: 0.90rem;
    line-height: 1.9;
    margin-bottom: 15px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: #888888;
    padding-top: 10px;
  }
  
  .meta-divider { color: #cccccc; margin: 0 4px; }
  @media (prefers-color-scheme: dark) { .meta-divider { color: #555555; } }

  .card-tags {
    margin-top: 10px;
    font-size: 0.95rem;
    color: #888888;
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .post-page-wrapper { padding: 20px 10px 30px; }
    .post-container { gap: 15px; }
    .notice-board { padding: 12px 15px; border-radius: 12px; }
    .notice-icon { font-size: 1.3rem; margin-right: 10px; }
    .notice-content { font-size: 0.85rem; }
    .card-info { padding: 20px 20px 10px; }
    .card-title { font-size: 1.7rem; }
    .card-meta { font-size: 0.85rem; }
    .meta-divider { display: none; }
  }
</style>