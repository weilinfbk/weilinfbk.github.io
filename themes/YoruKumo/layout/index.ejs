<%- partial('_partial/header') %>

<!-- 直接使用和文章页一模一样的外层容器，保证大小完全一致 -->
<div class="post-page-wrapper">
  <main class="post-container">
    
    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <!-- 封面图 -->
        <div class="card-cover">
          <a href="<%- url_for(post.path) %>">
            <img src="<%- post.cover || post.top_img || '/images/avatar.jpg' %>" alt="<%= post.title %>">
          </a>
        </div>
        
        <!-- 文字信息 -->
        <div class="card-info">
          <h2 class="card-title">
            <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
          </h2>
          
          <p class="card-excerpt">
            <%- strip_html(post.excerpt || post.content).substring(0, 60) %>...
          </p>
          
          <!-- 日期和分类 -->
          <div class="card-meta">
            <span class="card-date">📅 <%= date(post.date, 'YYYY-MM-DD HH:mm') %></span>
            <% if (post.categories && post.categories.length) { %>
              <span class="card-category">📁 <%= post.categories.data[0].name %></span>
            <% } %>
          </div>

          <!-- Tags -->
          <% if (post.tags && post.tags.length) { %>
            <div class="card-tags">
              🏷️ 
              <% post.tags.each(function(tag, index) { %>
                <span><%= tag.name %></span><% if (index < post.tags.length - 1) { %>, <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
      </article>
    <% }) %>

  </main>
</div>

<style>
  /* ⚠️ 这里的容器样式，完全是照抄 post.ejs 的，保证两边严丝合缝 */
  .post-page-wrapper {
    padding: 40px 20px 60px; 
    display: flex;
    justify-content: center;
  }

  .post-container {
    width: 100%;
    max-width: 850px; /* 文章页也是 850px */
    display: flex;
    flex-direction: column;
    gap: 20px; /* 卡片之间的缝隙 */
  }

  /* 单个卡片的基础样式 */
  .post-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  /* 暗色模式 */
  @media (prefers-color-scheme: dark) {
    .post-card {
      background: #1e1e1e;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
    }
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  .card-cover img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .card-info {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.4rem;
    margin: 0 0 12px 0;
    line-height: 1.5;
    font-weight: 700;
  }

  .card-title a { text-decoration: none; color: #222222; }
  .card-excerpt { color: #666666; }
  
  @media (prefers-color-scheme: dark) {
    .card-title a { color: #ffffff; }
    .card-excerpt { color: #aaaaaa; }
  }

  .card-excerpt {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #888888;
    border-top: 1px solid rgba(128,128,128,0.2);
    padding-top: 15px;
  }

  .card-tags {
    margin-top: 10px;
    font-size: 0.85rem;
    color: #888888;
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .post-page-wrapper { padding: 30px 10px 30px; }
    .post-container { gap: 15px; }
    .card-info { padding: 20px; }
    .card-title { font-size: 1.2rem; }
    .card-cover img { height: 180px; }
  }
</style>
